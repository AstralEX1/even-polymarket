# fake = built-in demo venue and odds, no keys needed. hyperliquid = Hyperliquid testnet + Polymarket live odds
VENUE=fake
# Shared secret the glasses app sends as a Bearer token. Required.
APP_TOKEN=
PORT=8788
HOST=127.0.0.1
# Real glasses: the https address of a tunnel to this server (tailscale funnel 8788, or cloudflared).
# `npm run pack` whitelists it and makes it the app's default server. Setting it requires a 16+ character APP_TOKEN.
PUBLIC_URL=
# Only the testnet host is accepted.
HL_BASE=https://api.hyperliquid-testnet.xyz
# Your testnet account (master) address. Reads use it.
HL_ACCOUNT=
# Private key of an API wallet made at app.hyperliquid-testnet.xyz/API. It can trade, it cannot withdraw.
HL_AGENT_KEY=
# Voice bets: speech-to-text. Leave empty to turn voice off. Audio is sent only after a tap.
OPENAI_API_KEY=
# Dev only: lets the local app connect without typing the token. Never set it for a build you share.
VITE_APP_TOKEN=
